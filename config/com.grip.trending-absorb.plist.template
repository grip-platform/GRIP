<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  GitHub Trending absorb — launchd agent TEMPLATE.

  Install (substitute __GRIP_HOME__ with $HOME/.claude):
      sed "s|__GRIP_HOME__|$HOME/.claude|g" \
        config/com.grip.trending-absorb.plist.template \
        > ~/Library/LaunchAgents/com.grip.trending-absorb.plist
      launchctl load ~/Library/LaunchAgents/com.grip.trending-absorb.plist
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grip.trending-absorb</string>
    <key>ProgramArguments</key>
    <array>
        <string>__GRIP_HOME__/venv/bin/python3</string>
        <string>__GRIP_HOME__/scripts/github_trending_absorb.py</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__GRIP_HOME__</string>
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>
    <key>StandardOutPath</key>
    <string>__GRIP_HOME__/logs/trending-absorb.log</string>
    <key>StandardErrorPath</key>
    <string>__GRIP_HOME__/logs/trending-absorb.err</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>CLAUDE_DIR</key>
        <string>__GRIP_HOME__</string>
        <key>PYTHONPATH</key>
        <string>__GRIP_HOME__/lib</string>
    </dict>
    <key>RunAtLoad</key>
    <false/>
    <key>Nice</key>
    <integer>10</integer>
    <key>TimeOut</key>
    <integer>1800</integer>
</dict>
</plist>
