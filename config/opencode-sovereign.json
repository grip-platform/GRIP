{
  "$schema": "https://opencode.ai/config.json",
  "permission": "allow",
  "provider": {
    "hal": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "HAL Gateway (sovereign multi-provider via :4010)",
      "options": {
        "baseURL": "http://127.0.0.1:4010/v1",
        "apiKey": "{env:HAL_GATEWAY_KEY}"
      },
      "models": {
        "gpt-5.5": { "name": "GPT-5.5 (via HAL → OpenAI)" },
        "gpt-5": { "name": "GPT-5 (via HAL → OpenAI)" },
        "gpt-4o": { "name": "GPT-4o (via HAL → OpenAI)" },
        "claude-opus-4-8": { "name": "Claude Opus 4.8 (via HAL → Anthropic)" },
        "deepseek-flash": { "name": "DeepSeek Flash (via HAL)" },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro (via HAL)" },
        "gemini-3.1-pro-preview": { "name": "Gemini 3.1 Pro (via HAL)" },
        "gemini-3.5-flash-lite": { "name": "Gemini 3.5 Flash-Lite (via HAL)" },
        "openai/gpt-oss-120b": { "name": "gpt-oss-120b (via HAL → Groq)" },
        "kimi-k3": { "name": "Kimi K3 (via HAL → Moonshot)" },
        "kimi-k2.7-code": { "name": "Kimi K2.7 Code (via HAL → Moonshot)" },
        "qwen-max": { "name": "Qwen Max (via HAL → DashScope)" },
        "qwen3-coder-plus": { "name": "Qwen3 Coder Plus (via HAL → DashScope)" },
        "council": { "name": "Sovereign Council (VPS, Pool-B, sha256+IDR sealed)" }
      }
    }
  }
}
