#!/usr/bin/env python3
"""grip-mine-patterns -- the deterministic half of session pattern mining.

GRIP writes down what it learns and then mostly cannot reach it. Measured 2026-09-01:
221 feedback records exist and 190 of them (86%) have no pointer in MEMORY.md, so they
are invisible to every dispatched agent, which inherits the index and the safety core
and nothing else (rules/binding-memory-records.md).

Findings sort into three classes and only two of them need a model:

    A  genuinely new              recurs, nothing covers it        -> the fleet judges
    B  recurs DESPITE a memory    written down and still failing   -> the fleet judges
    C  learned but unreachable    no index pointer                 -> ARITHMETIC, here

This tool owns C exactly, and narrows the corpus for A and B so the expensive lane reads
hundreds of turns instead of hundreds of thousands
(rules/llm-augmentation-pattern.md: deterministic floor, model above it).

Subcommands:
    reachability   Class C: records the index never points at. Exact, free, no model.
    friction       Pre-filter operator turns that look like corrections, for the fleet.
    receipt        Write or read the liveness receipt (see below).
    sessions       List the most recent session transcripts, newest first.

THE RECEIPT, AND WHY IT EXISTS. GRIP's previous always-on learner stopped producing on
2026-08-19 and nobody noticed for twelve days while 245 session directories accumulated;
its killswitch plist still points at a home directory that does not exist on this machine.
A scheduled job that fails silently is worse than no job, because it also supplies the
belief that something is watching. `receipt --write` stamps a run; `receipt --check`
fails loudly once the newest stamp is older than the staleness budget. Silence is the
failure this reports, not the success.

Exit codes -- 3 is NOT success, because "could not measure" must never be
indistinguishable from "nothing to report":
    0  ran, nothing outstanding
    1  ran, something outstanding (unreachable records, or a stale receipt)
    3  INDETERMINATE -- could not read what it needed
"""
from __future__ import annotations

import argparse
import json
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

_LIB = Path(__file__).resolve().parent.parent / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))

from claude_dir import get_claude_dir  # noqa: E402
from pattern_mining import (  # noqa: E402
    friction_turns,
    load_transcript,
    reachability_report,
)

EXIT_CLEAN, EXIT_OUTSTANDING, EXIT_INDETERMINATE = 0, 1, 3

RECEIPT = "state/pattern-mining/receipt.jsonl"
DEFAULT_STALE_HOURS = 30  # a daily cadence, plus slack for a missed slot


class AmbiguousCorpus(Exception):
    """Several genuinely different memory corpora exist and none was named."""


def _memory_dir(root: Path) -> Path | None:
    """The operator's project memory directory, whichever slug it lives under.

    De-duplicates by RESOLVED path before choosing, and refuses to guess between genuinely
    distinct corpora. Both halves are load-bearing.

    The projects tree aliases heavily: on this machine 252 paths match
    `projects/*/memory/MEMORY.md`, and `-Users-you--claude-overnight-workspace/memory` and
    `-Users-you--grip/memory` are the SAME directory (inode 1483414, identical contents).
    So a naive `sorted(...)[0]` returns an alias of the right corpus by luck rather than by
    reason — and on a machine where those paths were distinct it would silently measure the
    wrong one and report a confident number about it, which is the exact failure the
    workflow this tool feeds refuses to make.
    """
    resolved = {p.resolve().parent for p in root.glob("projects/*/memory/MEMORY.md")}
    if not resolved:
        return None
    if len(resolved) == 1:
        return resolved.pop()

    # Several genuine corpora. Prefer the one belonging to THIS install, identified by the
    # harness's own slug encoding of the root path. Measured here: 5 distinct corpora, of
    # which the slug match holds 456 records and the rest hold 2 to 7 — so picking by sort
    # order could have reported "2 records, 0 unreachable", a confidently clean bill on a
    # corpus nobody asked about.
    slug = str(root.resolve()).replace("/", "-").replace(".", "-")
    own = [p for p in resolved if p.parent.name == slug]
    if len(own) == 1:
        return own[0]
    raise AmbiguousCorpus(
        f"{len(resolved)} distinct memory corpora under {root} and none matches this "
        f"install's slug ({slug}); name one with --memory-dir. Candidates: "
        + ", ".join(sorted(str(p) for p in resolved)[:5])
    )


def _session_transcripts(root: Path, limit: int) -> list[Path]:
    """Session transcripts, newest first, de-duplicated by resolved path.

    The projects tree aliases the same session through many paths, so a naive glob
    returns the same file repeatedly.
    """
    seen = {p.resolve() for p in root.glob("projects/*/*.jsonl") if p.is_file()}
    return sorted(seen, key=lambda p: p.stat().st_mtime, reverse=True)[:limit]


def cmd_reachability(args, root: Path) -> int:
    if args.memory_dir:
        memory = Path(args.memory_dir).expanduser()
    else:
        try:
            memory = _memory_dir(root)
        except AmbiguousCorpus as exc:
            # Exit 3, never a guess: measuring the wrong corpus confidently is worse than
            # declining to measure.
            print(json.dumps({"error": str(exc), "measured": False}))
            return EXIT_INDETERMINATE
    if memory is None or not memory.is_dir():
        print(json.dumps({"error": f"no memory dir found under {root}", "measured": False}))
        return EXIT_INDETERMINATE
    report = reachability_report(memory)
    if args.json:
        print(json.dumps(report, indent=2))
    else:
        print(f"records={report['records']} reachable={report['reachable']} "
              f"unreachable={report['unreachable']} ({report['share_unreachable']:.0%})")
        for name in report["unreachable_records"][: args.limit]:
            print(f"  {name}")
        if report["unreachable"] > args.limit:
            print(f"  ... and {report['unreachable'] - args.limit} more (--limit to widen)")
    return EXIT_OUTSTANDING if report["unreachable"] else EXIT_CLEAN


def cmd_friction(args, root: Path) -> int:
    paths = _session_transcripts(root, args.sessions)
    if not paths:
        print(json.dumps({"error": "no session transcripts found", "measured": False}))
        return EXIT_INDETERMINATE
    out = []
    for path in paths:
        hits = friction_turns(load_transcript(path))
        if hits:
            out.append({"session": path.stem, "path": str(path), "turns": hits})
    payload = {
        "sessions_scanned": len(paths),
        "sessions_with_signal": len(out),
        "candidate_turns": sum(len(s["turns"]) for s in out),
        "note": "PRE-FILTER, not a verdict: these turns look like corrections and must be "
                "judged by a reader. Never report candidate_turns as a count of frictions.",
        "sessions": out,
    }
    print(json.dumps(payload, indent=2) if args.json else
          f"scanned={payload['sessions_scanned']} with_signal={payload['sessions_with_signal']} "
          f"candidates={payload['candidate_turns']}")
    return EXIT_CLEAN


def _receipt_path(root: Path) -> Path:
    return root / RECEIPT


def _newest_receipt(path: Path) -> dict | None:
    if not path.is_file():
        return None
    rows = [ln for ln in path.read_text(errors="replace").splitlines() if ln.strip()]
    for line in reversed(rows):
        try:
            return json.loads(line)
        except json.JSONDecodeError:
            continue
    return None


def _measure_for_receipt(root: Path) -> dict:
    """The Class-C state at stamp time, so the receipt records EVIDENCE, not just a run.

    A stamp saying only "something executed" is a signal that cannot disagree with reality:
    it reads identically whether the corpus is healthy or has silently lost half its
    pointers. Carrying the measured count lets a later audit correlate the cadence against
    the actual state, which is the whole reason to keep receipts at all.

    Fail-soft and explicit: a corpus that could not be measured records `unreachable: null`
    with the reason, never a zero. A zero here would be indistinguishable from a perfectly
    reachable corpus, which is the one reading that must never be manufactured.

    THIS FUNCTION MUST NEVER RAISE, and the broad except below is deliberate rather than
    lazy. The receipt exists so that a silently-dead cadence cannot pass for a live one; a
    measurement failure that propagated would abort the write and destroy the very evidence
    the stamp is for — leaving no receipt at all, which reads as "never ran". An earlier
    version subscripted the report directly and a malformed report would have done exactly
    that (caught by the AGORA council on PR #5234). Losing the count is a scratch; losing
    the stamp is the whole injury.
    """
    try:
        memory = _memory_dir(root)
        if memory is None:
            return {"unreachable": None, "measure_error": f"no memory dir under {root}"}
        report = reachability_report(memory)
        if "unreachable" not in report:
            return {"unreachable": None, "measure_error": f"report lacks 'unreachable': {sorted(report)}"}
        return {
            "unreachable": report.get("unreachable"),
            "records": report.get("records"),
            "memory_dir": report.get("memory_dir"),
        }
    except Exception as exc:  # noqa: BLE001 - see the contract above: never abort the stamp
        return {"unreachable": None, "measure_error": f"{type(exc).__name__}: {exc}"}


def cmd_receipt(args, root: Path) -> int:
    path = _receipt_path(root)
    if args.write:
        path.parent.mkdir(parents=True, exist_ok=True)
        stamp = {"at": datetime.now(timezone.utc).isoformat(), "note": args.write}
        stamp.update(_measure_for_receipt(root))
        with path.open("a") as fh:
            fh.write(json.dumps(stamp) + "\n")
        count = stamp.get("unreachable")
        detail = f"unreachable={count}" if count is not None else f"UNMEASURED ({stamp.get('measure_error')})"
        print(f"receipt written: {stamp['at']}  {detail}")
        return EXIT_CLEAN

    newest = _newest_receipt(path)
    if newest is None:
        # No receipt at all is the loudest possible answer, not a quiet pass.
        print(f"NO RECEIPT at {path} - the miner has never run, or its store is gone")
        return EXIT_OUTSTANDING
    try:
        when = datetime.fromisoformat(newest["at"])
    except (KeyError, ValueError):
        print(f"UNREADABLE RECEIPT at {path}: {newest}")
        return EXIT_INDETERMINATE
    age = datetime.now(timezone.utc) - when
    if age > timedelta(hours=args.stale_hours):
        print(f"STALE: newest receipt {when.isoformat()} is {age.total_seconds() / 3600:.1f}h "
              f"old, budget {args.stale_hours}h")
        return EXIT_OUTSTANDING
    print(f"fresh: {when.isoformat()} ({age.total_seconds() / 3600:.1f}h ago)")
    return EXIT_CLEAN


def cmd_sessions(args, root: Path) -> int:
    paths = _session_transcripts(root, args.sessions)
    if not paths:
        print(json.dumps({"error": "no session transcripts found", "measured": False}))
        return EXIT_INDETERMINATE
    for path in paths:
        print(path)
    return EXIT_CLEAN


HANDLERS = {
    "reachability": cmd_reachability,
    "friction": cmd_friction,
    "receipt": cmd_receipt,
    "sessions": cmd_sessions,
}


def _parse(argv: list[str]) -> argparse.Namespace:
    ap = argparse.ArgumentParser(prog="grip-mine-patterns", description=__doc__.split("\n")[0])
    ap.add_argument("--root", help="GRIP install to read (default: $CLAUDE_DIR)")
    sub = ap.add_subparsers(dest="cmd", required=True)

    r = sub.add_parser("reachability", help="Class C: records the index never points at")
    r.add_argument("--json", action="store_true")
    r.add_argument("--limit", type=int, default=20)
    r.add_argument("--memory-dir", help="measure THIS corpus instead of auto-detecting")

    f = sub.add_parser("friction", help="pre-filter correction-shaped operator turns")
    f.add_argument("--sessions", type=int, default=20)
    f.add_argument("--json", action="store_true")

    c = sub.add_parser("receipt", help="write or check the liveness receipt")
    c.add_argument("--write", metavar="NOTE", help="stamp a run with this note")
    c.add_argument("--stale-hours", type=int, default=DEFAULT_STALE_HOURS)

    s = sub.add_parser("sessions", help="list recent session transcripts, newest first")
    s.add_argument("--sessions", type=int, default=20)
    return ap.parse_args(argv)


def main(argv: list[str] | None = None) -> int:
    args = _parse(sys.argv[1:] if argv is None else argv)
    root = Path(args.root).expanduser() if args.root else get_claude_dir()
    if not root.is_dir():
        print(json.dumps({"error": f"no GRIP install at {root}", "measured": False}))
        return EXIT_INDETERMINATE
    return HANDLERS[args.cmd](args, root)


if __name__ == "__main__":
    raise SystemExit(main())
