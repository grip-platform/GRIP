#!/usr/bin/env python3
"""Report whether a Workflow run in the current session is stalled or
burning tokens fast. See rules/fan-out-spends-the-weekly-limit.md and
lib/spend_watchdog.py, which does the real work -- this is a thin CLI.

Usage:
  bin/grip-spend-watchdog [--session ID] [--json]

Run it with `py bin/grip-spend-watchdog` or `bin/grip-py bin/grip-spend-watchdog`
per rules/never-system-python-for-grip.md; it needs no cryptography, so a
system interpreter would also work, but the habit is the same either way.
"""
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_LIB = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_LIB))

from lib.claude_dir import get_claude_dir  # noqa: E402
from lib.path_encoding import encode_project_path  # noqa: E402
from lib.spend_watchdog import assess, render_line, resolve_session_id  # noqa: E402


def _no_session_output(as_json: bool) -> None:
    if as_json:
        print(json.dumps({"error": "no session resolved"}))
    else:
        print("[SPEND] no session resolved")


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--session", default=None, help="session id to inspect")
    parser.add_argument("--json", action="store_true", help="print the full assessment as JSON")
    args = parser.parse_args(argv)

    projects_dir = get_claude_dir() / "projects" / encode_project_path(str(Path.cwd()))
    # Respects a HAL_HOME override (Codex review, GRIP#8698): see the
    # matching comment in hooks/workflow-budget-gate.py.
    ledger_path = Path(os.environ.get("HAL_HOME") or Path.home() / ".hal") / "logs" / "cache-loss-ledger.jsonl"

    payload = {"session_id": args.session} if args.session else {}
    session_id = resolve_session_id(payload, dict(os.environ), projects_dir)
    if not session_id:
        _no_session_output(args.json)
        return 0

    result = assess(projects_dir / session_id, ledger_path, session_id)
    if args.json:
        print(json.dumps(result))
        return 0

    line = render_line(result)
    if line:
        print(line)
    return 0


if __name__ == "__main__":
    sys.exit(main())
