#!/usr/bin/env python3
"""grip-run -- run a task through GRIP with no interactive session.

    grip-run "<task>" [--origin operator|relay|cron] [--tools Read,Grep,Glob]
                      [--max-turns N] [--timeout SECONDS] [--model MODEL]

``gg++ -p "<task>"`` execs this. Spec (inputs, receipt schema, exit codes,
refusals): docs/headless-grip.md. Design this implements (Slice 1 of
"headless GRIP"): ~/.grip/drafts/headless-grip/brief.md and
~/.grip/drafts/ULTRAPROMPT-2026-10-01-headless-grip-hal-runtime.md. Thin
shim over lib.headless_run.
"""
import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from lib.headless_run import main  # noqa: E402

if __name__ == "__main__":
    # This shebang is `/usr/bin/env python3`, which need not be an interpreter
    # that can dual-sign. Without this the tool still runs and still writes a
    # receipt -- it just writes a forgeable demo-sealed IDR leaf when a real
    # seal was one interpreter away (lib/pq_reexec.py).
    #
    # Imported as top-level `pq_reexec` off THIS checkout, never as
    # `lib.pq_reexec`: by now `lib` may already be bound to another tree's
    # package, and the import would miss the file or read another branch's copy.
    import sys as _sys
    from pathlib import Path as _Path

    _sys.path.insert(0, str(_Path(__file__).resolve().parent.parent / "lib"))
    from pq_reexec import reexec_if_incapable as _reexec

    _reexec(_Path(__file__))
    raise SystemExit(main(sys.argv[1:]))
