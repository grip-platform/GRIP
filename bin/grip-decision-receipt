#!/usr/bin/env python3
"""grip-decision-receipt — CLI for the Decision Evidence Receipt (DER) composer.

    grip-decision-receipt generate <decision-log.json> [--sources F ...] [--out receipt.json]
                                   [--no-anchor] [--no-record]
    grip-decision-receipt verify   <receipt.json> [--root REPO_ROOT]

A DER is decision-PROVENANCE — cite.verify + a signed IDR + a Bitcoin
(OpenTimestamps) anchor. It is EVIDENCE-OF-RECORD only: NOT a compliance
guarantee and NOT a guarantee of admissibility. Any legal/regulatory decision on
top of it requires attorney review. Thin shim over lib.decision_evidence_receipt.
"""
import sys
from pathlib import Path

_ROOT = Path(__file__).resolve().parent.parent
if str(_ROOT) not in sys.path:
    sys.path.insert(0, str(_ROOT))

from lib.decision_evidence_receipt import main  # noqa: E402

if __name__ == "__main__":
    # This shebang is `/usr/bin/env python3`, which need not be an interpreter
    # that can dual-sign. Without this the tool still runs and still records --
    # it just writes a forgeable demo-sealed record when a real seal was one
    # interpreter away (lib/pq_reexec.py).
    #
    # Imported as top-level `pq_reexec` off THIS checkout, never as
    # `lib.pq_reexec`: by now `lib` may already be bound to another tree's
    # package, and the import would miss the file or read another branch's copy.
    import sys as _sys
    from pathlib import Path as _Path

    _sys.path.insert(0, str(_Path(__file__).resolve().parent.parent / "lib"))
    from pq_reexec import reexec_if_incapable as _reexec

    _reexec(_Path(__file__))
    raise SystemExit(main(sys.argv[1:]))
