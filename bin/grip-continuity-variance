#!/usr/bin/env python3
"""grip-continuity-variance — measure premise variance across every chain.

Answers the question from the 2026-09-10 brief
(drafts/ultraprompt-2026-09-10-continuity-corpus-variance.md): does the
push-recorder premise ("the pushed head contains the origin/main tip known
locally") carry enough variance for a precision measurement to ever
distinguish a predictor from the base rate?

Method (mirrors bin/grip-continuity-settle chain_files()):
- enumerate every continuity*.jsonl chain (session-namespaced included,
  contamination logs excluded)
- a premise is a continuity-commit record, addressed by its canonical
  content address (lib.precog.idr.content_addr — the coordinate verdicts
  carry as decision.commit_addr); verdicts are paired to premises BY THAT
  ADDRESS, never by predecessor_idr (which is chain-thread structure)
- each verdict settles a distinct commit (verified 2026-09-13: 174/174
  distinct), so every settled row is an independent observation
- every number is printed with the corpus it came from

Re-runnable: PYTHONPATH=$GRIP_REPO python3 bin/grip-continuity-variance
"""
from __future__ import annotations

import json
import math
import sys
from collections import Counter
from datetime import datetime
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from lib.continuity_chain import _STATE  # noqa: E402
from lib.precog.idr import content_addr  # noqa: E402


def chain_files(state: Path = _STATE) -> list[Path]:
    return sorted(p for p in state.glob("continuity*.jsonl")
                  if "contamination" not in p.name)


def load_records(state: Path) -> list[dict]:
    recs: list[dict] = []
    for chain in chain_files(state):
        for line in chain.read_text(errors="replace").splitlines():
            line = line.strip()
            if not line:
                continue
            try:
                r = json.loads(line)
            except Exception:
                continue
            if r.get("kind") in ("continuity-commit", "continuity-verdict"):
                recs.append(r)
    return recs


def wilson(r: float, n: int, z: float = 1.96) -> tuple[float, float]:
    if n == 0:
        return (0.0, 1.0)
    p = (r + z * z / (2 * n)) / (1 + z * z / n)
    half = z * math.sqrt((r * (1 - r) + z * z / (4 * n)) / n) / (1 + z * z / n)
    return (max(0.0, p - half), min(1.0, p + half))


def main() -> int:
    recs = load_records(_STATE)
    commits: dict[str, dict] = {}
    verdicts: list[dict] = []
    for r in recs:
        if r.get("kind") == "continuity-commit":
            commits[content_addr(r)] = r
        else:
            verdicts.append(r)

    push = Counter()
    other = Counter()
    lat: list[float] = []
    settled_addrs: set[str] = set()
    for v in verdicts:
        addr = (v.get("decision") or {}).get("commit_addr", "")
        commit = commits.get(addr)
        if commit is None:
            continue
        settled_addrs.add(addr)
        claim = (commit.get("decision") or {}).get("claim", "")
        verdict = (v.get("decision") or {}).get("verdict", "")
        if claim.startswith("push of"):
            push[verdict] += 1
        else:
            other[f"{claim[:60]} -> {verdict}"] += 1
        try:
            d0 = datetime.fromisoformat(v.get("ts", "").replace("Z", "+00:00"))
            d1 = datetime.fromisoformat(commit.get("ts", "").replace("Z", "+00:00"))
            lat.append((d0 - d1).total_seconds())
        except Exception:
            pass

    n = sum(push.values())
    inc = push.get("INCONGRUENT", 0)
    r = inc / n if n else 0.0
    lo, hi = wilson(r, n)

    print(f"chains scanned: {len(chain_files())}")
    print(f"premises registered: {len(commits)}")
    print(f"verdicts: {len(verdicts)} (distinct premises settled: "
          f"{len(settled_addrs)})")
    unsettled = len(commits) - len(settled_addrs)
    print(f"premises not yet settled: {unsettled}")
    print(f"\npush-recorder premises settled: n={n} "
          f"CONGRUENT={push.get('CONGRUENT', 0)} "
          f"INCONGRUENT={push.get('INCONGRUENT', 0)}")
    print(f"INCONGRUENT rate: {r:.3f}  (Wilson 95% CI [{lo:.3f}, {hi:.3f}])")
    for delta in (0.05, 0.10):
        if r in (0.0, 1.0):
            need = "infinite (rate at a boundary — no variance)"
        else:
            need = f"{4 * r * (1 - r) / (delta * delta):.0f}"
        print(f"  pushes needed for +-{delta} CI half-width: ~{need}")
    if lat:
        lat_sorted = sorted(lat)
        median = lat_sorted[len(lat_sorted) // 2]
        print(f"\nsettlement latency: n={len(lat)} "
              f"median={median / 3600:.1f}h min={lat_sorted[0]:.0f}s "
              f"max={lat_sorted[-1] / 3600:.1f}h")
    if other:
        print("\nnon-push premises:")
        for k, c in other.most_common():
            print(f"  n={c}  {k}")
    return 0


if __name__ == "__main__":
    # This shebang is `/usr/bin/env python3`, which need not be an interpreter
    # that can dual-sign. Without this the tool still runs and still records --
    # it just writes a forgeable demo-sealed record when a real seal was one
    # interpreter away (lib/pq_reexec.py).
    #
    # Imported as top-level `pq_reexec` off THIS checkout, never as
    # `lib.pq_reexec`: by now `lib` may already be bound to another tree's
    # package, and the import would miss the file or read another branch's copy.
    import sys as _sys
    from pathlib import Path as _Path

    _sys.path.insert(0, str(_Path(__file__).resolve().parent.parent / "lib"))
    from pq_reexec import reexec_if_incapable as _reexec

    _reexec(_Path(__file__))

    raise SystemExit(main())
