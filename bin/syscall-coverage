#!/usr/bin/env bash
# syscall-coverage - measure shim adoption per external boundary.
# Thin shim into lib/syscall_coverage.py for first-class CLI usage.
set -euo pipefail
CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
source "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/venv-utils.sh"
# The venv is required (lib.syscall_coverage needs GRIP's deps). resolve_venv_python
# falls back to system python, so accept it only from inside the venv.
PY="$(resolve_venv_python "$CLAUDE_DIR/venv" || true)"
if [[ "$PY" != "$CLAUDE_DIR/venv/"* ]]; then
    echo "[syscall-coverage] no GRIP venv Python at $CLAUDE_DIR/venv (looked for Scripts/python.exe, bin/python3, bin/python)" >&2
    exit 1
fi
exec "$PY" -m lib.syscall_coverage "$@"
