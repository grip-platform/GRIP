#!/usr/bin/env bash
# grip-meet-setup — one-command readiness bootstrap for grip-meet (macOS).
#
# Idempotent: skips anything already installed. Installs ffmpeg + blackhole-2ch
# (brew), openai-whisper (GRIP venv), pre-warms the ~244 MB whisper model so the
# FIRST real meeting does not stall on a silent download, narrates the one manual
# Audio MIDI Setup step (the CoreAudio GUI cannot be scripted), then runs
# `grip-meet doctor` as the verification gate (its exit code becomes ours).
#
# macOS-only BY DESIGN for v1: the capture stack is avfoundation/BlackHole/
# osascript-bound. See docs/grip-meet.md + drafts/grip-meet-packaging-scope.md.
set -euo pipefail

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
WHISPER_MODEL="small.en"
source "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/venv-utils.sh"
# The venv is required (this installs into it). resolve_venv_python falls back
# to system python, so accept its answer only from inside the venv.
PY="$(resolve_venv_python "$CLAUDE_DIR/venv" || true)"
[[ "$PY" == "$CLAUDE_DIR/venv/"* ]] || PY=""
WHISPER_BIN="$CLAUDE_DIR/venv/bin/whisper"
MODEL_PT="$HOME/.cache/whisper/${WHISPER_MODEL}.pt"

say()  { printf '\033[1;36m[grip-meet-setup]\033[0m %s\n' "$1"; }
warn() { printf '\033[1;33m[grip-meet-setup] %s\033[0m\n' "$1" >&2; }

# 0. macOS-only by design.
if [[ "$(uname)" != "Darwin" ]]; then
  warn "grip-meet is macOS-only for v1 (avfoundation capture). Aborting."
  exit 1
fi

# 1. Homebrew is the package source for ffmpeg + blackhole.
if ! command -v brew >/dev/null 2>&1; then
  warn "Homebrew not found. Install it from https://brew.sh then re-run."
  exit 1
fi

# 2. ffmpeg — mic capture, device enumeration, the start probe.
if command -v ffmpeg >/dev/null 2>&1; then
  say "ffmpeg present"
else
  say "installing ffmpeg…"
  brew install ffmpeg
fi

# 3. BlackHole loopback — captures a HEADPHONE call's downlink (a mic only hears
#    the room). The Multi-Output device is wired up in step 6 (manual).
if brew list blackhole-2ch >/dev/null 2>&1; then
  say "blackhole-2ch present"
else
  say "installing blackhole-2ch…"
  brew install blackhole-2ch
fi

# 4. whisper CLI — speech to text — into the GRIP venv (where grip-meet runs).
if [[ -x "$WHISPER_BIN" ]] || { [[ -x "$PY" ]] && "$PY" -c "import whisper" 2>/dev/null; }; then
  say "openai-whisper present"
else
  # Install through the interpreter resolved above, not a `bin/pip` console
  # script. Testing for `bin/pip` misdiagnosed a perfectly good venv as "not set
  # up" whenever it carried only `pip3`/`pip3.14`, or was made by uv.
  if [[ ! -x "$PY" ]]; then
    warn "GRIP venv Python not found under $CLAUDE_DIR/venv — is the GRIP venv set up?"
    exit 1
  fi
  say "installing openai-whisper into the GRIP venv…"
  "$PY" -m pip install -q openai-whisper
fi

# 5. Pre-warm the whisper model (~244 MB) on 1s of generated silence so the FIRST
#    real meeting does not stall minutes on a background download.
if [[ -f "$MODEL_PT" ]]; then
  say "whisper model ${WHISPER_MODEL} already cached"
else
  say "pre-downloading whisper model ${WHISPER_MODEL} (~244 MB, one-time)…"
  TMPD="$(mktemp -d)"
  trap 'rm -rf "$TMPD"' EXIT
  ffmpeg -hide_banner -loglevel error -f lavfi -i anullsrc=r=16000:cl=mono -t 1 "$TMPD/silence.wav" -y
  "$WHISPER_BIN" "$TMPD/silence.wav" --model "$WHISPER_MODEL" \
    --output_dir "$TMPD" --output_format txt >/dev/null 2>&1 || true
fi

# 6. The one manual step — the CoreAudio GUI cannot be scripted.
cat <<'EOF'

  ── One manual step: a Multi-Output Device (so you HEAR the call AND capture it) ──
  1. Open  Audio MIDI Setup  (Spotlight: "Audio MIDI Setup").
  2. Click  +  (bottom-left)  →  Create Multi-Output Device.
  3. Tick BOTH  "BlackHole 2ch"  AND your headphones/speakers.
  4. System Settings → Sound → Output: pick that Multi-Output Device for calls.
  5. grip-meet captures from BlackHole; you still hear everything.

EOF

# 7. Verification gate — doctor's exit code becomes ours (0 = fully ready).
say "running grip-meet doctor…"
exec "$CLAUDE_DIR/bin/grip-meet" doctor
