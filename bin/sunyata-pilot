#!/usr/bin/env python3
"""Sunyata EvidenceState pilot runner (paper §7–§8).

Runs the four systems under test (G0, B1, B2, G1) over the synthetic
SARS-style benchmark, computes the pre-registered H1/H2/H3 verdicts
(hypotheses H714–H716, deadline 2026-10-31), and writes the machine-
readable results to --out (default lib/sunyata_pilot/results.json).

Exit 0 on a completed run regardless of verdict outcome — a FALSIFIED
hypothesis is a successful measurement, per the paper's kill criteria.
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from datetime import datetime, timezone

REPO_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(REPO_ROOT, "lib"))
sys.path.insert(0, REPO_ROOT)

from sunyata_pilot.common import COVERAGE_FLOOR  # noqa: E402
from sunyata_pilot.benchmark.loader import load_scenarios  # noqa: E402
from sunyata_pilot.agents.g0 import G0Agent  # noqa: E402
from sunyata_pilot.agents.b1 import B1Agent  # noqa: E402
from sunyata_pilot.agents.b2 import B2Agent  # noqa: E402
from sunyata_pilot.agents.g1 import G1Agent  # noqa: E402
from sunyata_pilot.harness import (  # noqa: E402
    audit_accuracy,
    audit_steps,
    h1_verdict,
    h2_verdict,
    h3_verdict,
)

AGENTS = (G0Agent, B1Agent, B2Agent, G1Agent)

HYPOTHESES = {
    "H1": "H714",
    "H2": "H715",
    "H3": "H716",
}


def run_agent(agent_cls, scenarios):
    agent = agent_cls()
    return [(agent.run(s), s) for s in scenarios]


def aggregate(results):
    total = 0
    fabrications = 0
    resolved = 0
    for run, scenario in results:
        for d in run.dispositions:
            total += 1
            if d.action == "assert" and d.value is not None:
                resolved += 1
                if scenario.gold[d.var].disposition == "must-suspend":
                    fabrications += 1
    coverage = (resolved / total) if total else 0.0
    return {"fabrications": fabrications, "n_vars": total, "coverage": round(coverage, 4)}


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--out", default=os.path.join(REPO_ROOT, "lib", "sunyata_pilot", "results.json"))
    parser.add_argument("--quiet", action="store_true")
    args = parser.parse_args(argv)

    scenarios = load_scenarios()
    runs = {agent_cls.name: run_agent(agent_cls, scenarios) for agent_cls in AGENTS}

    h1 = h1_verdict(runs["G0"], runs["G1"], runs["B1"], runs["B2"])
    h2 = h2_verdict(runs["G0"], runs["B1"], runs["G1"])
    h3 = h3_verdict({"B1": runs["B1"], "B2": runs["B2"], "G1": runs["G1"]})

    per_agent = {name: aggregate(res) for name, res in runs.items()}

    results = {
        "generated": datetime.now(timezone.utc).isoformat(),
        "hypotheses": HYPOTHESES,
        "coverage_floor": COVERAGE_FLOOR,
        "n_scenarios": len(scenarios),
        "per_agent": per_agent,
        "H1": h1,
        "H2": h2,
        "H3": h3,
    }

    with open(args.out, "w", encoding="utf-8") as fh:
        json.dump(results, fh, indent=2, sort_keys=True)

    if not args.quiet:
        print(f"Sunyata EvidenceState pilot — {len(scenarios)} scenarios, "
              f"coverage floor {COVERAGE_FLOOR}")
        for name, agg in per_agent.items():
            print(f"  {name}: {agg['fabrications']} fabrications / "
                  f"{agg['n_vars']} vars, coverage {agg['coverage']}")
        print(f"H1 (H714): {h1['verdict']}")
        print(f"H2 (H715): {h2['verdict']}")
        print(f"H3 (H716): {h3['verdict']}")
        if "committed_line" in h3:
            print(f"  committed line: {h3['committed_line']}")
        print(f"results: {args.out}")

    return 0


if __name__ == "__main__":
    # This shebang is `/usr/bin/env python3`, which need not be an interpreter
    # that can dual-sign. Without this the tool still runs and still records --
    # it just writes a forgeable demo-sealed record when a real seal was one
    # interpreter away (lib/pq_reexec.py).
    #
    # Imported as top-level `pq_reexec` off THIS checkout, never as
    # `lib.pq_reexec`: by now `lib` may already be bound to another tree's
    # package, and the import would miss the file or read another branch's copy.
    import sys as _sys
    from pathlib import Path as _Path

    _sys.path.insert(0, str(_Path(__file__).resolve().parent.parent / "lib"))
    from pq_reexec import reexec_if_incapable as _reexec

    _reexec(_Path(__file__))
    raise SystemExit(main())
