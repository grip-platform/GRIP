#!/usr/bin/env python3
"""grip-infinite-stop — operator kill switch for the HAL InfiniteMachine.

Engaging writes the marker the HAL gateway reads (lib/hal/gateway_brake.py,
reported live on GET /health): InfiniteMachine absorption/serving features
freeze while the verbatim witnessed relay keeps serving — the safe state is
"plain gateway", never "no gateway". Sibling of bin/grip-stop (the WhatsApp
outbound brake) and deliberately a DISTINCT marker file: the two brakes
never trip each other.

    grip-infinite-stop on [reason...]   # engage
    grip-infinite-stop off              # release
    grip-infinite-stop status           # show state
"""
from __future__ import annotations

import datetime as _dt
import json
import os
import sys
from pathlib import Path


def marker_path() -> Path:
    explicit = (os.environ.get("HAL_INFINITE_BRAKE_MARKER") or "").strip()
    if explicit:
        return Path(explicit).expanduser()
    base = (os.environ.get("CLAUDE_DIR") or "").strip() or str(Path.home() / ".claude")
    return Path(base) / "state" / "session" / "infinite-stop.json"


def engage(reason: str) -> int:
    marker = marker_path()
    marker.parent.mkdir(parents=True, exist_ok=True)
    marker.write_text(json.dumps({
        "engaged_at": _dt.datetime.now().isoformat(timespec="seconds"),
        "by": "grip-infinite-stop",
        "reason": reason or "manual",
    }, indent=2))
    print("grip-infinite-stop: ENGAGED — InfiniteMachine absorption frozen "
          "(verbatim relay keeps serving) until `grip-infinite-stop off`")
    return 0


def release() -> int:
    marker = marker_path()
    if marker.exists():
        marker.unlink()
        print("grip-infinite-stop: RELEASED")
    else:
        print("grip-infinite-stop: already released (no marker)")
    return 0


def status() -> int:
    marker = marker_path()
    if not marker.exists():
        print("grip-infinite-stop: released")
        return 0
    try:
        detail = json.loads(marker.read_text())
    except Exception:
        detail = None
    print(f"grip-infinite-stop: ENGAGED ({marker})")
    if detail:
        print(json.dumps(detail, indent=2))
    else:
        print("  (marker unreadable — still brakes: fail-closed on presence)")
    return 0


def main(argv: list) -> int:
    cmd = argv[0] if argv else "status"
    if cmd == "on":
        return engage(" ".join(argv[1:]))
    if cmd == "off":
        return release()
    if cmd == "status":
        return status()
    sys.stderr.write(__doc__)
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
