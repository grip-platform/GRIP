#!/usr/bin/env python3
"""grip-infinite-witness — is HAL Infinite actually live on THIS session?

Five claims about the wire, each answered from evidence that exists whether or
not the answer is flattering, and each paired with a falsifier this script
RUNS rather than asserts.

Why this exists rather than ``bin/grip-infinite-probe``: that probe decides
``verdict = "CONFIRMED" if result["subscription_billed"] else "REFUTED"``,
which keys only on WHICH credential went out and never on whether the turn
SUCCEEDED. A 401 carrying a well-formed OAuth bearer prints CONFIRMED there.
(GRIP #5033 fixes it; unmerged at the time of writing.)

Exit codes are three-valued on purpose. 0 = every claim green, 1 = a claim is
RED, 3 = something could not be established. 3 is deliberately not 0: an
unknown must never be indistinguishable from a pass, which is the failure
shape this whole feature keeps reproducing.
"""

from __future__ import annotations

import argparse
import datetime as dt
import hashlib
import hmac
import json
import os
import shutil
import socket
import sys
import tempfile
import urllib.error
import urllib.request
from collections import Counter
from pathlib import Path
from typing import Any

GREEN, RED, GREY = "PASS", "FAIL", "UNVERIFIED"
_DEFAULT_URL = "http://127.0.0.1:4010"


def hal_home() -> Path:
    return Path(os.environ.get("HAL_HOME", str(Path.home() / ".hal")))


def audit_path() -> Path:
    return hal_home() / "logs" / "gateway-audit.jsonl"


def signed_path() -> Path:
    return hal_home() / "logs" / "gateway-chat-signed.jsonl"


def key_path() -> Path:
    return hal_home() / "logs" / "gateway-chat-audit.key"


def _now() -> dt.datetime:
    return dt.datetime.now(dt.timezone.utc)


def _parse_ts(raw: str) -> dt.datetime | None:
    try:
        return dt.datetime.fromisoformat(raw.replace("Z", "+00:00"))
    except Exception:
        return None


class Claim:
    """One question, its verdict, its evidence, and the falsifier that ran."""

    def __init__(self, cid: str, question: str) -> None:
        self.cid = cid
        self.question = question
        self.verdict = GREY
        self.evidence: list[str] = []
        self.falsifier = ""
        self.falsifier_ok: bool | None = None

    def as_dict(self) -> dict[str, Any]:
        return {
            "id": self.cid,
            "question": self.question,
            "verdict": self.verdict,
            "evidence": self.evidence,
            "falsifier": self.falsifier,
            "falsifier_held": self.falsifier_ok,
        }


def read_rows(path: Path, since: dt.datetime, tail_bytes: int = 4_000_000) -> list[dict]:
    """Rows newer than `since`. Reads a bounded tail — the ledger is ~37MB."""
    if not path.exists():
        return []
    out: list[dict] = []
    with path.open("rb") as fh:
        size = fh.seek(0, 2)
        fh.seek(max(0, size - tail_bytes))
        if size > tail_bytes:
            fh.readline()  # discard the partial line
        for line in fh:
            try:
                row = json.loads(line)
            except Exception:
                continue
            ts = _parse_ts(row.get("ts", ""))
            if ts and ts >= since:
                out.append(row)
    return out


# ---------------------------------------------------------------- C1: the wire

def claim_wire(url: str) -> Claim:
    c = Claim("C1-WIRE", "Is this session pointed at the gateway, and does the gateway answer as one?")
    base = os.environ.get("ANTHROPIC_BASE_URL")
    wired = bool(base)
    c.evidence.append(f"ANTHROPIC_BASE_URL={base or '(unset)'}")
    c.evidence.append(f"GRIP_INFINITE={os.environ.get('GRIP_INFINITE', '(unset)')}")
    if not wired:
        c.evidence.append("ANTHROPIC_BASE_URL is unset — this session talks to Anthropic directly")

    # Probe the url the CALLER resolved, not a re-read of the environment.
    # Re-reading made the parameter dead and main()'s _DEFAULT_URL fallback
    # unreachable; it also meant an unwired session learned nothing about
    # whether a gateway was even running. The probe now always runs and is
    # reported separately from the wiring verdict.
    #
    # LIMIT, stated rather than implied: `service` is a self-declared JSON
    # string. This proves the endpoint ANSWERS AS the gateway; it does not
    # prove identity. A process squatting the port and returning the same
    # body would pass. Binding this to a nonce signed by the gateway's audit
    # key is the real fix and is not attempted here.
    try:
        with urllib.request.urlopen(f"{url.rstrip('/')}/health", timeout=5) as r:
            health = json.loads(r.read())
    except Exception as exc:
        c.verdict = RED
        c.evidence.append(f"GET /health failed: {exc!r}")
        return c

    if health.get("ok") is True and health.get("service") == "hal-gateway":
        c.verdict = GREEN if wired else RED
        c.evidence.append(f"GET {url} /health -> ok=True service={health.get('service')!r} "
                          f"(self-declared; answers-as, not proof-of-identity)")
        brake = (health.get("brake") or {}).get("engaged")
        c.evidence.append(f"operator brake engaged={brake}")
        if brake:
            c.verdict = RED
            c.evidence.append("brake ENGAGED — new sessions are not wired")
    else:
        c.verdict = RED
        c.evidence.append(f"/health did not identify as hal-gateway: {health!r}")

    # Falsifier: the same probe against a port nothing listens on must go RED.
    dead = _free_port()
    c.falsifier = f"same /health probe against 127.0.0.1:{dead} (nothing listening) must fail"
    try:
        urllib.request.urlopen(f"http://127.0.0.1:{dead}/health", timeout=3)
        c.falsifier_ok = False  # it answered — the probe proves nothing
    except Exception:
        c.falsifier_ok = True
    return c


def _free_port() -> int:
    s = socket.socket()
    s.bind(("127.0.0.1", 0))
    port = s.getsockname()[1]
    s.close()
    return port


# ------------------------------------------------------------- C2: real transit

def claim_transit(window_min: int) -> Claim:
    c = Claim("C2-TRANSIT", "Is this session's traffic observably crossing the gateway?")
    since = _now() - dt.timedelta(minutes=window_min)
    rows = read_rows(audit_path(), since)
    if not audit_path().exists():
        c.verdict = GREY
        c.evidence.append(f"no ledger at {audit_path()}")
        return c

    served = [r for r in rows if r.get("event") == "served"]
    models = Counter(r.get("model") for r in rows if r.get("model"))
    c.evidence.append(f"{len(rows)} ledger rows in the last {window_min}m ({len(served)} served)")
    c.evidence.append(f"models observed: {dict(models) or '(none)'}")
    if rows:
        c.evidence.append(f"newest row ts={rows[-1].get('ts')}")

    c.verdict = GREEN if served else RED
    if not served:
        c.evidence.append("no forwarded requests — the env var is set but nothing transits")

    # Falsifier (controlled input, not live traffic): the reader's window
    # filter must EXCLUDE a row stamped before the window opens. The previous
    # form asserted the LEDGER was idle for one minute an hour ago — a property
    # of the traffic, not of the filter. On a gateway that served anything in
    # that minute the claim went blind and downgraded the whole run to
    # UNVERIFIED; on an idle one it passed vacuously. Neither exercised the
    # filter it claimed to be testing.
    c.falsifier = "read_rows must exclude a synthetic row stamped before the window opens"
    c.falsifier_ok = _window_filter_holds()
    if not c.falsifier_ok:
        c.evidence.append("WINDOW FILTER SUSPECT: read_rows admitted an out-of-window row")
    return c


def _window_filter_holds() -> bool:
    """Does `read_rows` actually drop rows older than `since`?

    Controlled: two synthetic rows, one two hours old and one current, read
    back with a one-hour window. Only the fresh row may survive. Deterministic
    and independent of whatever the live gateway happened to be doing.
    """
    stale = {"ts": (_now() - dt.timedelta(hours=2)).isoformat(),
             "event": "served", "_probe": "stale"}
    fresh = {"ts": _now().isoformat(), "event": "served", "_probe": "fresh"}
    fh = tempfile.NamedTemporaryFile("w", suffix=".jsonl", delete=False)
    try:
        with fh:
            for row in (stale, fresh):
                fh.write(json.dumps(row) + "\n")
        got = read_rows(Path(fh.name), _now() - dt.timedelta(hours=1))
        return [r.get("_probe") for r in got] == ["fresh"]
    finally:
        Path(fh.name).unlink(missing_ok=True)


# ---------------------------------------------------------------- C3: it worked

# Only these paths carry a Claude Code TURN. /v1/models is a catalogue lookup
# and /v1/chat/completions is the cross-wire rail; a 401 on either says
# something about a probe, never that a turn failed. Excluding them is a real
# scoping decision, so every excluded row is printed rather than swallowed.
_TURN_RAIL = "/v1/messages"


def _is_nonok_turn(row: dict) -> bool:
    """Is `row` a turn-rail response that did NOT return 200?

    `status` is coerced before comparison: a ledger that serialised it as the
    string "200" must not read as a failure, which would force a false RED.
    An unparseable status is treated as not-a-success — an unreadable outcome
    is not evidence of a good one.
    """
    if row.get("event") != "served":
        return False
    if str(row.get("path", "")).split("?")[0] != _TURN_RAIL:
        return False
    status = row.get("status")
    if status is None:
        return False
    try:
        return int(status) != 200
    except (TypeError, ValueError):
        return True


def session_anchor() -> tuple[dt.datetime | None, str]:
    """When did THIS session get wired? Read it from the launch ledger.

    Judging a session by traffic that predates it is how you inherit someone
    else's failure. The wire ledger records one row per launch decision, so
    its newest ``wired: true`` row is this session's start.
    """
    wire = Path(os.environ.get("CLAUDE_DIR", str(Path.home() / ".claude")))
    wire = wire / "state" / "hal-infinite" / "wire.jsonl"
    if not wire.exists():
        return None, f"no wire ledger at {wire}"
    anchor = None
    for line in wire.read_text().splitlines():
        try:
            row = json.loads(line)
        except Exception:
            continue
        if row.get("wired") is True:
            ts = _parse_ts(row.get("ts", ""))
            if ts:
                anchor = ts
    if anchor is None:
        return None, "wire ledger has no wired=true row"
    return anchor, f"session anchored at {anchor.isoformat()} (newest wired=true in wire.jsonl)"


def claim_auth(window_min: int) -> Claim:
    """The #5033 defect: custody intact on a turn that never authenticated."""
    c = Claim("C3-AUTH", "Did this session's turns actually authenticate, or merely leave?")

    anchor, why = session_anchor()
    floor = _now() - dt.timedelta(minutes=window_min)
    if anchor and anchor > floor:
        since, scope = anchor, why
    else:
        since, scope = floor, f"{why}; falling back to a {window_min}m window"
    c.evidence.append(scope)

    rows = [r for r in read_rows(audit_path(), since) if r.get("event") == "served"]
    if not rows:
        c.verdict = GREY
        c.evidence.append("no served rows since the anchor — nothing to judge")
        return c

    turns = [r for r in rows if str(r.get("path", "")).split("?")[0] == _TURN_RAIL]
    other = [r for r in rows if r not in turns]

    # Print what was set aside, and why, so the scoping is auditable.
    if other:
        c.evidence.append(
            f"excluded {len(other)} non-turn row(s) — not turns: "
            + ", ".join(sorted({f"{r.get('path')}={r.get('status')}" for r in other}))
        )

    if not turns:
        c.verdict = GREY
        c.evidence.append(f"no {_TURN_RAIL} rows since the anchor — no turns to judge")
        return c

    codes = Counter(r.get("status") for r in turns)
    ok = codes.get(200, 0)
    authfail = codes.get(401, 0) + codes.get(403, 0)
    throttled = codes.get(429, 0)
    c.evidence.append(f"{len(turns)} turn(s) on {_TURN_RAIL}: {dict(codes)}")
    c.evidence.append(f"200={ok}  401/403={authfail}  429={throttled}")

    if ok == 0:
        c.verdict = RED
        c.evidence.append("ZERO successful turns — the wire carries traffic that never lands")
    elif authfail:
        c.verdict = RED
        c.evidence.append(f"{authfail} auth failure(s) on the turn rail — custody intact is NOT success")
    else:
        c.verdict = GREEN
    if throttled:
        c.evidence.append(f"NOTE {throttled}x 429 — rate limited, not an auth failure")

    # Anything the scope excluded that still looks like a real failure gets
    # surfaced as context. Narrowing the verdict must never hide a signal.
    pre = [r for r in read_rows(audit_path(), _now() - dt.timedelta(hours=2))
           if r.get("event") == "served"
           and str(r.get("path", "")).split("?")[0] == _TURN_RAIL
           and r.get("status") in (401, 403)
           and (ts := _parse_ts(r.get("ts", ""))) and ts < since]
    if pre:
        c.evidence.append(
            f"CONTEXT: {len(pre)} pre-session turn-rail auth failure(s) in the last 2h "
            f"(newest {pre[-1].get('ts')}) — outside this session's scope, not silently dropped"
        )

    # Falsifier (controlled input): the SAME predicate that scores the live
    # rows must flag a synthetic 401 on the turn rail. The previous form
    # required the live ledger to already contain real failures, which made
    # CONFIRMED unreachable on a healthy gateway — an instrument that cannot
    # clear a clean system is exactly backwards for a witness.
    probe = [{"event": "served", "path": _TURN_RAIL, "status": 200},
             {"event": "served", "path": _TURN_RAIL, "status": 401}]
    detected = [r for r in probe if _is_nonok_turn(r)]
    c.falsifier = f"the non-200 predicate must flag a synthetic 401 on {_TURN_RAIL}"
    c.falsifier_ok = [r["status"] for r in detected] == [401]

    wide = read_rows(audit_path(), _now() - dt.timedelta(hours=24))
    nonok = [r for r in wide if _is_nonok_turn(r)]
    c.evidence.append(
        f"instrument sensitivity: predicate flags a synthetic 401; "
        f"{len(nonok)} real non-200 turn-rail row(s) in the 24h tail "
        f"({dict(Counter(r.get('status') for r in nonok))})"
    )
    return c


# --------------------------------------------------------------- C4: custody

def claim_custody() -> Claim:
    c = Claim("C4-CUSTODY", "Does this session bill the subscription, or pay-per-token credits?")
    ambient = {k: os.environ.get(k) for k in ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN")}
    present = {k: v for k, v in ambient.items() if v}
    for k, v in ambient.items():
        c.evidence.append(f"{k}: " + (f"PRESENT (len={len(v)})" if v else "absent"))

    if present:
        c.verdict = RED
        c.evidence.append(
            "an ambient key makes Claude Code send x-api-key — the subscription is BYPASSED, "
            "through the gateway and around it alike"
        )
    else:
        c.verdict = GREEN
        c.evidence.append("no ambient key — the OAuth bearer is what goes out")

    # Falsifier: the same check under an injected key must flip to RED,
    # otherwise it is not reading the environment at all.
    probe_env = dict(os.environ, ANTHROPIC_API_KEY="sk-ant-api03-" + "x" * 20)
    would_flip = bool(probe_env.get("ANTHROPIC_API_KEY"))
    c.falsifier = "the same predicate under an injected ANTHROPIC_API_KEY must report PRESENT"
    c.falsifier_ok = would_flip
    return c


# ------------------------------------------------------------------ C5: chain

def _canonical(body: dict) -> bytes:
    return json.dumps(body, sort_keys=True, separators=(",", ":")).encode("utf-8")


def _verify_chain(path: Path, key: bytes, limit: int) -> tuple[int, int, list[str]]:
    """Recompute the HMAC chain over the last `limit` rows. Returns (ok, checked, errors)."""
    rows: list[dict] = []
    with path.open("rb") as fh:
        size = fh.seek(0, 2)
        fh.seek(max(0, size - 400_000))
        if size > 400_000:
            fh.readline()
        for line in fh:
            try:
                rows.append(json.loads(line))
            except Exception:
                continue
    rows = rows[-limit:]
    ok = 0
    errors: list[str] = []
    prev: str | None = None
    for i, row in enumerate(rows):
        body = {k: v for k, v in row.items() if k != "hmac"}
        expected = hmac.new(key, _canonical(body), hashlib.sha256).hexdigest()
        if not hmac.compare_digest(expected, row.get("hmac", "")):
            errors.append(f"row {i}: HMAC mismatch")
            continue
        if prev is not None and row.get("prev_hmac") != prev:
            errors.append(f"row {i}: broken linkage")
            continue
        prev = row.get("hmac")
        ok += 1
    return ok, len(rows), errors


def claim_chain(limit: int) -> Claim:
    c = Claim("C5-CHAIN", "Is the witness record tamper-evident, or just a text file?")
    sp, kp = signed_path(), key_path()
    if not sp.exists() or not kp.exists():
        c.verdict = GREY
        c.evidence.append(f"missing {'signed log' if not sp.exists() else 'key'}")
        return c
    key = kp.read_bytes()
    c.evidence.append(f"key {kp} ({len(key)} bytes, mode {oct(kp.stat().st_mode)[-3:]})")

    ok, checked, errors = _verify_chain(sp, key, limit)
    c.evidence.append(f"verified {ok}/{checked} most-recent rows (HMAC + prev_hmac linkage)")
    c.verdict = GREEN if checked and ok == checked else RED
    for e in errors[:3]:
        c.evidence.append(f"chain error: {e}")

    # Falsifier: tamper one field on a COPY. If verification still passes,
    # the chain proves nothing and a green above is theatre.
    with tempfile.TemporaryDirectory() as td:
        clone = Path(td) / "tampered.jsonl"
        shutil.copy(sp, clone)
        raw = clone.read_text().splitlines()
        if raw:
            last = json.loads(raw[-1])
            last.setdefault("payload", {})["status"] = 999  # flip a fact
            raw[-1] = json.dumps(last)
            clone.write_text("\n".join(raw) + "\n")
            t_ok, t_checked, _ = _verify_chain(clone, key, limit)
            c.falsifier = "flipping one status field on a copy must break verification"
            c.falsifier_ok = t_ok < t_checked
            c.evidence.append(
                f"tamper test: altered 1 field -> {t_ok}/{t_checked} verified "
                f"({'REJECTED as expected' if t_ok < t_checked else 'ACCEPTED — chain is not tamper-evident'})"
            )
    return c


# ------------------------------------------------------------------- reporting

def main() -> int:
    ap = argparse.ArgumentParser(description="Prove (or refute) that HAL Infinite is live on this session.")
    ap.add_argument("--window", type=int, default=10, help="minutes of ledger to inspect (default 10)")
    ap.add_argument("--chain-rows", type=int, default=200, help="signed rows to verify (default 200)")
    ap.add_argument("--json", action="store_true", help="emit machine-readable JSON")
    args = ap.parse_args()

    claims = [
        claim_wire(os.environ.get("ANTHROPIC_BASE_URL") or _DEFAULT_URL),
        claim_transit(args.window),
        claim_auth(args.window),
        claim_custody(),
        claim_chain(args.chain_rows),
    ]

    verdicts = [c.verdict for c in claims]
    if RED in verdicts:
        overall, rc = "REFUTED", 1
    elif GREY in verdicts:
        overall, rc = "UNVERIFIED", 3
    else:
        overall, rc = "CONFIRMED", 0

    # A claim whose falsifier did not hold is not evidence, whatever it says.
    blind = [c.cid for c in claims if c.falsifier_ok is False]
    if blind:
        overall, rc = "UNVERIFIED", 3

    if args.json:
        print(json.dumps({
            "overall": overall,
            "exit_code": rc,
            "generated_at": _now().isoformat(),
            "blind_claims": blind,
            "claims": [c.as_dict() for c in claims],
        }, indent=2))
        return rc

    print()
    print("  HAL INFINITE — live witness")
    print(f"  {_now().isoformat(timespec='seconds')}   ledger {audit_path()}")
    print("  " + "-" * 68)
    for c in claims:
        mark = {GREEN: "PASS", RED: "FAIL", GREY: "  ??"}[c.verdict]
        print(f"\n  [{mark}] {c.cid} — {c.question}")
        for e in c.evidence:
            print(f"         {e}")
        if c.falsifier:
            held = {True: "held", False: "DID NOT HOLD — claim is blind", None: "not run"}[c.falsifier_ok]
            print(f"         falsifier: {c.falsifier}")
            print(f"         falsifier: {held}")
    print("\n  " + "-" * 68)
    print(f"  VERDICT : {overall}   (exit {rc})")
    if blind:
        print(f"  WARNING : {', '.join(blind)} could not be falsified — treat as unproven")
    print()
    return rc


if __name__ == "__main__":
    sys.exit(main())
