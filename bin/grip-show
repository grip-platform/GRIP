#!/usr/bin/env bash
# grip-show -- open a file or folder, or reveal it in the file manager, on any
# platform. One verb that does the obvious thing:
#
#   show <file>        opens it in its default application
#   show <folder>      opens a file-manager window showing the folder
#   show -r <path>     reveals the item selected inside its parent folder
#   show -n <path>     dry run: prints the exact command, runs nothing
#
# Platforms: macOS (open / open -R), Linux desktop (xdg-open / the D-Bus
# FileManager1.ShowItems call, which selects the item where xdg-open on the
# parent cannot), Windows Git Bash and WSL (explorer.exe), and a headless box
# with no desktop at all (pages a file, lists a folder, marks the item in its
# parent). Bash only -- no Python, no Node: on a teammate's Windows machine
# `python3` may be the Microsoft Store alias that passes every check and runs
# nothing, and bash 3.2 (stock macOS) must be enough.
#
# Exit codes: 0 done . 1 the path does not exist . 2 usage . 3 no launcher.
# GRIP_SHOW_PLATFORM=darwin|linux|windows|wsl|headless overrides detection, so
# tests can exercise every branch on every CI runner.
#
# The verb is `show`, not `view`: /usr/bin/view is vim's read-only mode on
# macOS and most Linux, and a function named view would shadow it silently.
# Ratified with V>> on 2026-10-02 after a sovereign council sitting (seal
# 1f47e253330877a5), which also supplied the Windows details below.
set -u

usage() {
    printf '%s\n' \
        'usage: grip-show [-r|--reveal] [-n|--dry-run] <path>' \
        '  show <file>      open it in its default application' \
        '  show <folder>    open a file-manager window showing it' \
        '  show -r <path>   reveal the item selected inside its parent folder' \
        '  show -n <path>   print the command that would run, run nothing'
}

detect_platform() {
    if [ -n "${GRIP_SHOW_PLATFORM:-}" ]; then
        printf '%s\n' "$GRIP_SHOW_PLATFORM"
        return
    fi
    case "$(uname -s 2>/dev/null)" in
        Darwin) printf 'darwin\n' ;;
        MINGW*|MSYS*|CYGWIN*) printf 'windows\n' ;;
        *)
            if [ -n "${WSL_DISTRO_NAME:-}" ] || grep -qi microsoft /proc/version 2>/dev/null; then
                printf 'wsl\n'
            elif [ -n "${DISPLAY:-}" ] || [ -n "${WAYLAND_DISPLAY:-}" ]; then
                printf 'linux\n'
            else
                printf 'headless\n'
            fi ;;
    esac
}

# Absolute path with no trailing separator, without needing realpath (absent
# on stock macOS before 13 and on some minimal Linux images).
resolve_path() {
    local p="$1" dir base
    if [ -d "$p" ]; then
        (cd -- "$p" && pwd -P)
    else
        dir="$(dirname -- "$p")"
        base="$(basename -- "$p")"
        dir="$(cd -- "$dir" && pwd -P)"
        if [ "$dir" = / ]; then printf '/%s\n' "$base"; else printf '%s/%s\n' "$dir" "$base"; fi
    fi
}

# Windows path for explorer.exe. cygpath exists on every Git for Windows;
# WSL has wslpath instead. A trailing backslash makes explorer.exe open the
# drive root, so it is stripped -- except on a bare drive, where it is the path.
to_windows_path() {
    local p="$1" w
    if command -v cygpath >/dev/null 2>&1; then
        w="$(cygpath -w "$p")"
    elif command -v wslpath >/dev/null 2>&1; then
        w="$(wslpath -w "$p")"
    else
        printf 'grip-show: neither cygpath nor wslpath found; passing the path unconverted\n' >&2
        w="$p"
    fi
    w="${w%\\}"
    case "$w" in ?:) w="$w\\" ;; esac
    printf '%s\n' "$w"
}

# file:// URI with every byte outside the unreserved set percent-encoded, which
# is what FileManager1.ShowItems wants (a space is "%20", never a space).
file_uri() {
    local s="$1" out="" i c
    local LC_ALL=C
    for ((i = 0; i < ${#s}; i++)); do
        c="${s:i:1}"
        case "$c" in
            [A-Za-z0-9/._~-]) out="$out$c" ;;
            *) out="$out$(printf '%%%02X' "'$c")" ;;
        esac
    done
    printf 'file://%s\n' "$out"
}

# Fills CMD (the argv) and ENVPFX (VAR=value words to put in front of it).
build_command() {
    local platform="$1" mode="$2" p="$3" w pager
    CMD=()
    ENVPFX=()
    case "$platform" in
        darwin)
            if [ "$mode" = reveal ]; then CMD=(open -R "$p"); else CMD=(open "$p"); fi ;;
        linux)
            if [ "$mode" = reveal ] && command -v dbus-send >/dev/null 2>&1; then
                CMD=(dbus-send --session --print-reply
                     --dest=org.freedesktop.FileManager1 /org/freedesktop/FileManager1
                     org.freedesktop.FileManager1.ShowItems
                     "array:string:$(file_uri "$p")" "string:")
            elif [ "$mode" = reveal ]; then
                CMD=(xdg-open "$(dirname -- "$p")")
            else
                CMD=(xdg-open "$p")
            fi ;;
        windows|wsl)
            w="$(to_windows_path "$p")"
            # Git Bash rewrites any argument that starts with "/" into a
            # Windows path, which would turn "/select," into C:\...\select,.
            # MSYS_NO_PATHCONV is Git for Windows' switch for that; a plain
            # MSYS2 shell ignores it and honours MSYS2_ARG_CONV_EXCL instead,
            # so both are set for this one command (an AGORA concern on
            # GRIP#7009, R0-tested: true for MSYS2, moot for Git for Windows).
            # On WSL both are simply ignored. explorer.exe opens a file with
            # its associated program and a folder as a window; `cmd //c start`
            # was rejected because cmd re-parses "&" and "^" in the path.
            ENVPFX=(MSYS_NO_PATHCONV=1 "MSYS2_ARG_CONV_EXCL=*")
            if [ "$mode" = reveal ]; then CMD=(explorer.exe "/select," "$w"); else CMD=(explorer.exe "$w"); fi ;;
        headless)
            if [ "$mode" = reveal ]; then CMD=(ls -la "$(dirname -- "$p")")
            elif [ -d "$p" ]; then CMD=(ls -la "$p")
            else
                # $PAGER may carry options ("less -R"); word-split it the way
                # git and man do, so the options reach the pager as arguments
                # rather than being glued to its name (GRIP#7009's judge).
                pager="$(pick_pager)"
                # shellcheck disable=SC2206
                CMD=($pager "$p")
            fi ;;
        *)
            printf 'grip-show: unknown platform %s (GRIP_SHOW_PLATFORM)\n' "$platform" >&2
            exit 2 ;;
    esac
}

pick_pager() {
    local candidate
    for candidate in "${PAGER:-}" less more; do
        [ -n "$candidate" ] || continue
        if command -v "${candidate%% *}" >/dev/null 2>&1; then
            printf '%s\n' "$candidate"
            return
        fi
    done
    printf 'grip-show-print\n'
}

# Fallback pager when neither $PAGER, less nor more exists (minimal containers).
grip-show-print() {
    local line
    while IFS= read -r line || [ -n "$line" ]; do printf '%s\n' "$line"; done < "$1"
}

run_headless_reveal() {
    local p="$1" base
    base="$(basename -- "$p")"
    printf '%s\n' "$p"
    ls -la "$(dirname -- "$p")" | awk -v b="$base" \
        '{ print (substr($0, length($0) - length(b) + 1) == b ? "> " : "  ") $0 }'
}

main() {
    local mode=open dry=0 target p platform
    while [ $# -gt 0 ]; do
        case "$1" in
            -r|--reveal) mode=reveal ;;
            -n|--dry-run) dry=1 ;;
            -h|--help) usage; return 0 ;;
            --) shift; break ;;
            -*) printf 'grip-show: unknown option %s\n' "$1" >&2; usage >&2; return 2 ;;
            *) break ;;
        esac
        shift
    done
    if [ $# -ne 1 ]; then usage >&2; return 2; fi
    target="$1"
    if [ ! -e "$target" ]; then
        printf 'grip-show: no such file or folder: %s\n' "$target" >&2
        return 1
    fi
    p="$(resolve_path "$target")"
    platform="$(detect_platform)"
    build_command "$platform" "$mode" "$p"

    if [ "$dry" = 1 ]; then
        printf '%q ' ${ENVPFX[@]+"${ENVPFX[@]}"} "${CMD[@]}"
        printf '\n'
        return 0
    fi
    if [ "$platform" = headless ] && [ "$mode" = reveal ]; then
        run_headless_reveal "$p"
        return
    fi
    if [ "${CMD[0]}" = grip-show-print ]; then
        grip-show-print "$p"
        return
    fi
    if ! command -v "${CMD[0]%% *}" >/dev/null 2>&1; then
        printf 'grip-show: %s is not available on this machine\n' "${CMD[0]}" >&2
        return 3
    fi
    if [ ${#ENVPFX[@]} -gt 0 ]; then
        env "${ENVPFX[@]}" "${CMD[@]}"
    else
        "${CMD[@]}"
    fi
}

main "$@"
