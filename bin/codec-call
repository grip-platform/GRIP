#!/usr/bin/env bash
# codec-call — /140.85 easter-egg TUI delight
# Opens a Mei Ling-style codec call showing current GRIP session state.
# Matches the /stealth protocol's frequency 140.85.
#
# Usage: codec-call              — status only
#        codec-call --save       — also trigger grip_save (canonical Mei Ling action)
#        codec-call --short      — single-line codec (for hooks / statusline)

set -euo pipefail

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
source "$(dirname "${BASH_SOURCE[0]}")/../scripts/lib/venv-utils.sh"
if ! VENV_PY="$(resolve_venv_python "$CLAUDE_DIR/venv")"; then
  echo "[codec-call] no Python interpreter found (searched $CLAUDE_DIR/venv, then PATH)" >&2
  exit 1
fi

SAVE=0
SHORT=0
for arg in "$@"; do
  case "$arg" in
    --save)  SAVE=1 ;;
    --short) SHORT=1 ;;
  esac
done

export CODEC_SAVE="$SAVE"
export CODEC_SHORT="$SHORT"

"$VENV_PY" - <<'PY'
import json
import os
import random
import subprocess
import sys
import time
from pathlib import Path

CLAUDE_DIR = Path(os.environ.get("CLAUDE_DIR", Path.home() / ".claude"))
sys.path.insert(0, str(CLAUDE_DIR / "lib"))
from path_encoding import encode_project_path  # noqa: E402
from _compat import grip_python  # noqa: E402 -- needs lib/ on sys.path first
_PROJECT_SLUG = encode_project_path(CLAUDE_DIR)
SAVE = os.environ.get("CODEC_SAVE") == "1"
SHORT = os.environ.get("CODEC_SHORT") == "1"

# --- ANSI palette -----------------------------------------------------------
C = {
    "reset":  "\033[0m",
    "dim":    "\033[2m",
    "bold":   "\033[1m",
    "green":  "\033[38;5;46m",   # codec green
    "amber":  "\033[38;5;214m",
    "cyan":   "\033[38;5;51m",
    "grey":   "\033[38;5;240m",
    "bg":     "\033[48;5;235m",
    "ml":     "\033[38;5;213m",  # Mei Ling pink
}

# --- Live state readers -----------------------------------------------------
def read_instance():
    """Return latest instance record (with message_count, lineage.generation)
    plus the top-level index metadata."""
    try:
        proj_dir = CLAUDE_DIR / "projects" / _PROJECT_SLUG / "grip"
        idx_path = proj_dir / "index.json"
        if not idx_path.exists():
            return {}
        idx = json.loads(idx_path.read_text())
        instances = idx.get("instances") or []
        latest = instances[-1] if isinstance(instances, list) and instances else {}
        lineage = latest.get("lineage", {}) if isinstance(latest, dict) else {}
        return {
            "generation": lineage.get("generation", idx.get("generation", "?")),
            "message_count": latest.get("message_count", "?"),
            "branch": lineage.get("branch") or idx.get("branch", "?"),
        }
    except Exception:
        return {}

def read_genome():
    try:
        g = json.loads((CLAUDE_DIR / "cache" / "genome.json").read_text())
        # Fitness fallback chain: fitness -> composite_fitness -> latest history -> 0.0
        fitness = g.get("fitness")
        if fitness is None:
            fitness = g.get("composite_fitness")
        if fitness is None:
            hist = g.get("fitness_history") or []
            fitness = hist[-1] if hist else 0.0
        history = g.get("fitness_history") or []
        # Last 10 numeric entries, defensively coerced.
        trend = []
        for v in history[-10:]:
            try:
                trend.append(float(v))
            except (TypeError, ValueError):
                continue
        return {
            "gen": g.get("generation", g.get("gen", "?")),
            "genes": len(g.get("genes", [])),
            "fitness": float(fitness) if fitness is not None else 0.0,
            "trend": trend,
        }
    except Exception:
        return {"gen": "?", "genes": 0, "fitness": 0.0, "trend": []}


def peek_next_fib():
    """Compute the fib_id of the NEXT `--save` call without mutating state.

    Reads state/missions/counter.json and returns (next_mission_number, next_fib).
    Safe if the counter has never been written — both values default to 1.
    """
    try:
        cp = CLAUDE_DIR / "state" / "missions" / "counter.json"
        if not cp.exists():
            return 1, 1
        s = json.loads(cp.read_text())
        n = int(s.get("mission_number", 0)) + 1
        curr = int(s.get("curr_fib", 1))
        return n, (curr if n > 1 else 1)
    except Exception:
        return 1, 1

def current_branch():
    try:
        return subprocess.check_output(
            ["git", "-C", str(CLAUDE_DIR), "branch", "--show-current"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip() or "?"
    except Exception:
        return "?"

def dirty_count():
    try:
        out = subprocess.check_output(
            ["git", "-C", str(CLAUDE_DIR), "status", "--short"],
            text=True, stderr=subprocess.DEVNULL,
        )
        return len([l for l in out.splitlines() if l.strip()])
    except Exception:
        return 0

def predictions_breakdown():
    """Return (confirmed, refuted, pending) from hypotheses.jsonl.
    Treats 'falsified' as a synonym for 'refuted'."""
    try:
        hpath = CLAUDE_DIR / "learning" / "hypotheses.jsonl"
        if not hpath.exists():
            return (0, 0, 0)
        c = r = p = 0
        for line in hpath.read_text().splitlines():
            try:
                s = json.loads(line).get("status", "pending")
            except Exception:
                continue
            if s == "confirmed":
                c += 1
            elif s in ("refuted", "falsified"):
                r += 1
            elif s == "pending":
                p += 1
        return (c, r, p)
    except Exception:
        return (0, 0, 0)

def read_identity():
    """Active operator signature (V>>, A>>, etc.) from session state."""
    try:
        ai = CLAUDE_DIR / "state" / "session" / "active-identity"
        if ai.exists():
            val = ai.read_text().strip()
            return val or "?"
    except Exception:
        pass
    return "?"

def read_project():
    """Return a human-friendly project name from the git remote, or fall
    back to the git toplevel directory name."""
    cwd = os.getcwd()
    try:
        url = subprocess.check_output(
            ["git", "-C", cwd, "config", "--get", "remote.origin.url"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
        if url:
            # git@github.com:owner/repo.git or https://github.com/owner/repo(.git)
            slug = url.rstrip("/")
            if slug.endswith(".git"):
                slug = slug[:-4]
            if slug.startswith("git@") and ":" in slug:
                slug = slug.split(":", 1)[1]
            elif "://" in slug:
                slug = slug.split("://", 1)[1]
                slug = slug.split("/", 1)[1] if "/" in slug else slug
            return slug or "?"
    except Exception:
        pass
    try:
        top = subprocess.check_output(
            ["git", "-C", cwd, "rev-parse", "--show-toplevel"],
            text=True, stderr=subprocess.DEVNULL,
        ).strip()
        if top:
            return Path(top).name
    except Exception:
        pass
    return "?"

def read_dir():
    """Home-relative cwd for display."""
    try:
        cwd = os.getcwd()
        home = str(Path.home())
        if cwd.startswith(home):
            return "~" + cwd[len(home):]
        return cwd
    except Exception:
        return "?"

