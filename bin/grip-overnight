#!/usr/bin/env python3
"""grip-overnight — control the dual-track lean-wave overnight loop.

    grip-overnight on --until 8h [--interval 3600] [--interval-b 14400]
    grip-overnight off
    grip-overnight stop
    grip-overnight status

Track A (opencode, non-Anthropic, DEFAULT): hourly  cron --runner opencode
Track B (claude -p, Max, sparse):           4-hourly cron --runner claude

Two managed cron entries (Linux) or two launchd plists (macOS) are installed
atomically by ``on``. The shared ``should_fire`` gate and per-track dir-locks
prevent collision when both tracks fire concurrently.
"""
from __future__ import annotations

import argparse
import plistlib
import subprocess
import sys
import time
from pathlib import Path

_LIB = Path(__file__).resolve().parent.parent / "lib"
if str(_LIB) not in sys.path:
    sys.path.insert(0, str(_LIB))
import overnight_loop as ol  # noqa: E402

# ── constants ─────────────────────────────────────────────────────────────────

LABEL_A = "com.grip.overnight-loop-opencode"
LABEL_B = "com.grip.overnight-loop"          # back-compat (was LABEL)
VENV_PY = ol.CLAUDE_DIR / "venv" / "bin" / "python3"
WRAPPER = ol.CLAUDE_DIR / "bin" / "grip-overnight-wave"
_IS_MAC = sys.platform == "darwin"

PLIST_LIVE_A = Path.home() / "Library" / "LaunchAgents" / f"{LABEL_A}.plist"
PLIST_LIVE_B = Path.home() / "Library" / "LaunchAgents" / f"{LABEL_B}.plist"
PLIST_REF_A  = ol.CLAUDE_DIR / "config" / f"{LABEL_A}.plist"
PLIST_REF_B  = ol.CLAUDE_DIR / "config" / f"{LABEL_B}.plist"

CRON_MARKER_A = "# grip-overnight-opencode (managed by bin/grip-overnight)"
CRON_MARKER_B = "# grip-overnight-loop (managed by bin/grip-overnight)"
OVERNIGHT_LOG = ol.CLAUDE_DIR / "logs" / "overnight-loop.out"

# Track-B hardening (issue #3808): PR #3801's env-gated controls lived as a
# MANUAL prefix on the claude-track cron line, but this generator owns the
# crontab/plists and dropped them on every regeneration — silently reverting
# the wave to unhardened (no --tools capability lock, account-default model,
# no git isolation). Emitted here onto every generated claude-track surface
# so the hardening survives regen. "cheap" resolves to DEFAULT_WAVE_MODEL
# inside overnight_loop._model_pin_args; Track A (opencode) is untouched.
TRACK_B_HARDENING = {
    "GRIP_OVERNIGHT_CAPABILITY_LOCK": "1",
    "GRIP_OVERNIGHT_GIT_ISOLATE": "1",
    "GRIP_OVERNIGHT_MODEL": "cheap",
}


def _track_env(runner: str) -> dict[str, str]:
    """Env vars emitted onto a generated track surface (claude = Track B)."""
    return dict(TRACK_B_HARDENING) if runner == "claude" else {}


# ── cron helpers (Linux) ──────────────────────────────────────────────────────

def _cron_schedule(interval: int) -> str:
    if interval < 3600:
        return f"*/{max(1, interval // 60)} * * * *"
    if interval == 3600:
        return "0 * * * *"
    if interval % 3600 == 0:
        return f"0 */{interval // 3600} * * *"
    return f"*/{min(59, interval // 60)} * * * *"


def _cron_line(interval: int, runner: str, marker: str) -> str:
    sched = _cron_schedule(interval)
    env = "".join(f"{k}={v} " for k, v in _track_env(runner).items())
    return (f"{sched} cd {ol.CLAUDE_DIR} && "
            f"PATH=/usr/local/bin:/usr/bin:/bin {env}/usr/bin/python3 {WRAPPER} "
            f"--runner {runner} >> {OVERNIGHT_LOG} 2>&1  {marker}")


def _crontab_lines() -> list[str]:
    r = subprocess.run(["crontab", "-l"], capture_output=True, text=True)
    return r.stdout.splitlines() if r.returncode == 0 else []


def _crontab_write(lines: list[str]) -> None:
    text = ("\n".join(lines) + "\n") if lines else ""
    subprocess.run(["crontab", "-"], input=text, text=True, check=True)


def _install_cron(interval_a: int, interval_b: int) -> None:
    lines = [ln for ln in _crontab_lines()
             if CRON_MARKER_A not in ln and CRON_MARKER_B not in ln]
    lines.append(_cron_line(interval_a, "opencode", CRON_MARKER_A))
    lines.append(_cron_line(interval_b, "claude",   CRON_MARKER_B))
    _crontab_write(lines)


def _uninstall_cron() -> None:
    _crontab_write([ln for ln in _crontab_lines()
                    if CRON_MARKER_A not in ln and CRON_MARKER_B not in ln])


# ── plist helpers (macOS) ─────────────────────────────────────────────────────

def _plist_dict(label: str, interval: int, runner: str) -> dict:
    logs = ol.CLAUDE_DIR / "logs"
    d = {
        "Label": label,
        "ProgramArguments": [str(VENV_PY), str(WRAPPER), "--runner", runner],
        "StartInterval": interval,
        "RunAtLoad": True,
        "StandardOutPath": str(logs / "overnight-loop.out"),
        "StandardErrorPath": str(logs / "overnight-loop.err"),
    }
    env = _track_env(runner)
    if env:
        d["EnvironmentVariables"] = env
    return d


_TRACKS = [
    # (label,   interval_attr, runner,     plist_live,   plist_ref)
    (LABEL_A, "interval_a", "opencode", PLIST_LIVE_A, PLIST_REF_A),
    (LABEL_B, "interval_b", "claude",   PLIST_LIVE_B, PLIST_REF_B),
]


def _install(interval_a: int, interval_b: int) -> None:
    if not _IS_MAC:
        OVERNIGHT_LOG.parent.mkdir(parents=True, exist_ok=True)
        _install_cron(interval_a, interval_b)
        return
    intervals = {"interval_a": interval_a, "interval_b": interval_b}
    for label, iv_attr, runner, plist_live, plist_ref in _TRACKS:
        d = _plist_dict(label, intervals[iv_attr], runner)
        plist_live.parent.mkdir(parents=True, exist_ok=True)
        plist_ref.parent.mkdir(parents=True, exist_ok=True)
        for target in (plist_live, plist_ref):
            with target.open("wb") as fh:
                plistlib.dump(d, fh)
        subprocess.run(["launchctl", "unload", str(plist_live)], capture_output=True)
        subprocess.run(["launchctl", "load",   str(plist_live)],
                       capture_output=True, check=True)


# ── yolo ──────────────────────────────────────────────────────────────────────

def _yolo(active: bool) -> None:
    try:
        if str(ol.CLAUDE_DIR) not in sys.path:
            sys.path.insert(0, str(ol.CLAUDE_DIR))
        from lib.gates.yolo_mode import activate_yolo, deactivate_yolo
        if active:
            activate_yolo("/grip-overnight", ttl_seconds=14400,
                          reason="overnight lean-wave loop")
        else:
            deactivate_yolo("/grip-overnight")
    except Exception:  # noqa: BLE001
        pass


# ── commands ──────────────────────────────────────────────────────────────────

def cmd_on(args) -> int:
    now = time.time()
    deadline = ol.parse_until(args.until, now_epoch=now)
    ol.write_cfg({
        "enabled": True, "deadline_epoch": deadline,
        "interval_a_s": args.interval, "interval_b_s": args.interval_b,
        "started_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(now)),
        "until": args.until, "by": "grip-overnight",
    })
    if ol.STOP_MARKER.exists():
        ol.STOP_MARKER.unlink()
    _yolo(True)
    _install(args.interval, args.interval_b)
    hrs = round((deadline - now) / 3600, 1)
    trig = ("launchd loaded (RunAtLoad fires waves now)" if _IS_MAC
            else "cron installed (waves fire at next interval ticks)")
    print(f"[grip-overnight] ON — A every {args.interval}s, "
          f"B every {args.interval_b}s, until {args.until} (~{hrs}h); {trig}.")
    return 0


def cmd_off(_args) -> int:
    cfg = ol.load_cfg() or {}
    cfg["enabled"] = False
    ol.write_cfg(cfg)
    if _IS_MAC:
        for _, _, _, plist_live, _ in _TRACKS:
            subprocess.run(["launchctl", "unload", str(plist_live)],
                           capture_output=True)
    else:
        _uninstall_cron()
    _yolo(False)
    trig = "launchd unloaded" if _IS_MAC else "cron removed"
    print(f"[grip-overnight] OFF — disabled, {trig}, yolo cleared.")
    return 0


def cmd_stop(_args) -> int:
    ol.STOP_MARKER.parent.mkdir(parents=True, exist_ok=True)
    ol.STOP_MARKER.touch()
    print("[grip-overnight] STOP marker set — gate closes on next wave check.")
    return 0


def cmd_status(_args) -> int:
    print(f"config: {ol.load_cfg()}")
    print(f"STOP={ol.STOP_MARKER.exists()}  "
          f"lock_A={ol.WAVE_LOCK_A.exists()}  lock_B={ol.WAVE_LOCK.exists()}")
    if _IS_MAC:
        for label, _, _, _, _ in _TRACKS:
            r = subprocess.run(["launchctl", "list", label], capture_output=True)
            print(f"launchd {label}: {r.returncode == 0}")
    else:
        lines = _crontab_lines()
        print(f"cron Track A (opencode): {any(CRON_MARKER_A in ln for ln in lines)}")
        print(f"cron Track B (claude):   {any(CRON_MARKER_B in ln for ln in lines)}")
    if ol.LOG_PATH.exists():
        print("recent waves:")
        for line in ol.LOG_PATH.read_text(encoding="utf-8").splitlines()[-5:]:
            print(" ", line[:160])
    return 0


# ── entry ─────────────────────────────────────────────────────────────────────

def main(argv: list[str]) -> int:
    p = argparse.ArgumentParser(prog="grip-overnight")
    sub = p.add_subparsers(dest="cmd", required=True)
    on = sub.add_parser("on")
    on.add_argument("--until", default="8h")
    on.add_argument("--interval",   type=int, default=ol.DEFAULT_INTERVAL_A)
    on.add_argument("--interval-b", dest="interval_b",
                    type=int, default=ol.DEFAULT_INTERVAL_B)
    on.set_defaults(fn=cmd_on)
    sub.add_parser("off").set_defaults(fn=cmd_off)
    sub.add_parser("stop").set_defaults(fn=cmd_stop)
    sub.add_parser("status").set_defaults(fn=cmd_status)
    args = p.parse_args(argv)
    return args.fn(args)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
