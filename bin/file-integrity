#!/usr/bin/env python3
"""file-integrity — CLI wrapper for lib/file_integrity_monitor.

Subcommands:
    register <path>     register a file
    unregister <path>   remove from registry
    verify              verify all registered files (exit 1 on any failure)
    refresh <path>      update stored hash after legitimate change
    list                list registered entries

Exit codes:
    0 — success / verify passed
    1 — verify failure
    2 — usage error / missing argument
    3 — file not found / not a regular file
"""

from __future__ import annotations

import json
import sys
from pathlib import Path

# Repo root is parent of this bin/ directory
_REPO_ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(_REPO_ROOT))

from lib.file_integrity_monitor import (  # noqa: E402
    list_registered,
    refresh,
    register,
    unregister,
    verify_all,
)


def _usage() -> int:
    sys.stderr.write(
        "usage: file-integrity {register|unregister|refresh} <path>\n"
        "       file-integrity {verify|list}\n"
    )
    return 2


def _cmd_register(path: str) -> int:
    try:
        entry = register(path)
    except FileNotFoundError as e:
        sys.stderr.write(f"error: {e}\n")
        return 3
    except ValueError as e:
        sys.stderr.write(f"error: {e}\n")
        return 3
    print(json.dumps({"registered": path, **entry}, indent=2, sort_keys=True))
    return 0


def _cmd_unregister(path: str) -> int:
    removed = unregister(path)
    if not removed:
        sys.stderr.write(f"note: not registered: {path}\n")
        return 0
    print(json.dumps({"unregistered": path}, indent=2, sort_keys=True))
    return 0


def _cmd_refresh(path: str) -> int:
    try:
        entry = refresh(path)
    except FileNotFoundError as e:
        sys.stderr.write(f"error: {e}\n")
        return 3
    except KeyError as e:
        sys.stderr.write(f"error: {e}\n")
        return 3
    print(json.dumps({"refreshed": path, **entry}, indent=2, sort_keys=True))
    return 0


def _cmd_verify() -> int:
    failures = verify_all()
    if not failures:
        print(json.dumps({"verify": "ok", "failures": []}, indent=2, sort_keys=True))
        return 0
    print(
        json.dumps(
            {"verify": "failed", "failures": failures},
            indent=2,
            sort_keys=True,
        )
    )
    return 1


def _cmd_list() -> int:
    entries = list_registered()
    print(json.dumps({"count": len(entries), "entries": entries}, indent=2, sort_keys=True))
    return 0


_DISPATCH_NO_ARG = {
    "verify": _cmd_verify,
    "list": _cmd_list,
}

_DISPATCH_ONE_ARG = {
    "register": _cmd_register,
    "unregister": _cmd_unregister,
    "refresh": _cmd_refresh,
}


def main(argv: list[str]) -> int:
    if len(argv) < 2:
        return _usage()
    cmd = argv[1]
    if cmd in _DISPATCH_NO_ARG:
        if len(argv) != 2:
            return _usage()
        return _DISPATCH_NO_ARG[cmd]()
    if cmd in _DISPATCH_ONE_ARG:
        if len(argv) != 3:
            return _usage()
        return _DISPATCH_ONE_ARG[cmd](argv[2])
    return _usage()


if __name__ == "__main__":
    sys.exit(main(sys.argv))
