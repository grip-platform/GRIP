#!/usr/bin/env bash
# caffeinate-keepalive-launchd — install / uninstall the launchd schedule for
# the caffeinate keepalive tick. macOS-only.
#
# Same shape as bin/agora-tick-launchd. See docs/caffeinate-keepalive-loop.md
# for full operator notes.
#
# Usage:
#   bin/caffeinate-keepalive-launchd install    # template → ~/Library/LaunchAgents/, bootstrap
#   bin/caffeinate-keepalive-launchd uninstall  # bootout + remove (idempotent)
#   bin/caffeinate-keepalive-launchd status     # is the agent loaded?
#   bin/caffeinate-keepalive-launchd run-now    # one-off invocation (for testing)

set -uo pipefail

CLAUDE_DIR="${CLAUDE_DIR:-$HOME/.claude}"
LABEL="com.codetonight.caffeinate-keepalive"
TEMPLATE="$CLAUDE_DIR/launchd/$LABEL.plist"
TARGET="$HOME/Library/LaunchAgents/$LABEL.plist"
LOG_DIR="$CLAUDE_DIR/logs"

usage() { echo "Usage: $(basename "$0") {install|uninstall|status|run-now}"; exit 1; }
log() { echo "[caffeinate-keepalive-launchd] $*" >&2; }
err() { echo "[caffeinate-keepalive-launchd] ERROR: $*" >&2; }

if [[ "$(uname -s)" != "Darwin" ]]; then
    err "launchd is macOS-only. caffeinate is also macOS-only — no Linux variant needed."
    exit 2
fi

cmd="${1:-}"
case "$cmd" in
    install)
        if [[ ! -f "$TEMPLATE" ]]; then
            err "template not found: $TEMPLATE"
            exit 1
        fi
        mkdir -p "$LOG_DIR" "$(dirname "$TARGET")"
        sed "s|__CLAUDE_DIR__|$CLAUDE_DIR|g" "$TEMPLATE" > "$TARGET"
        log "installed plist → $TARGET"
        launchctl bootout "gui/$UID/$LABEL" 2>/dev/null || true
        if launchctl bootstrap "gui/$UID" "$TARGET" 2>&1; then
            log "bootstrapped $LABEL into gui/$UID"
            log "schedule: every 1h on :17 (24 firings/day)"
            log "logs: $LOG_DIR/caffeinate-keepalive.{log,err}"
        else
            err "launchctl bootstrap failed — check 'launchctl print gui/$UID/$LABEL'"
            exit 3
        fi
        ;;
    uninstall)
        launchctl bootout "gui/$UID/$LABEL" 2>/dev/null && \
            log "booted out $LABEL" || log "$LABEL was not loaded"
        if [[ -f "$TARGET" ]]; then
            rm -f "$TARGET"
            log "removed $TARGET"
        fi
        ;;
    status)
        if launchctl print "gui/$UID/$LABEL" >/dev/null 2>&1; then
            launchctl print "gui/$UID/$LABEL" | head -25
        else
            log "$LABEL is NOT loaded"
            exit 1
        fi
        ;;
    run-now)
        log "kickstarting $LABEL once"
        launchctl kickstart -k "gui/$UID/$LABEL" 2>&1 || {
            err "kickstart failed — install first?"
            exit 4
        }
        log "kickstart issued; recent log tail:"
        sleep 2
        tail -10 "$LOG_DIR/caffeinate-keepalive.log" 2>/dev/null || true
        tail -5 "$LOG_DIR/caffeinate-keepalive.err" 2>/dev/null || true
        ;;
    *)
        usage
        ;;
esac
