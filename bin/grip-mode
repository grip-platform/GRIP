#!/usr/bin/env bash
# grip-mode — generic session-marker toggle (the YSH shim behind afk/rc/...).
#
# One `<name> on|off|status` marker-flip so simple session modes (afk, rc,
# future verbs) never clone grip-yolo's Python or hand-roll their own JSON
# marker. The real work lives in lib/session_mode.py (argv-passthrough — no
# heredoc, no shell-injection surface); this is a thin exec wrapper.
#
# grip-yolo is intentionally SEPARATE: its marker is gate-integrated
# (lib/gates/yolo_mode) with preset/bypass semantics, and the name 'yolo' is
# reserved — this shim refuses it.
#
# Usage
#   grip-mode <name> on  [--ttl SECONDS] [--note "text"] [--activator WHO]
#   grip-mode <name> off                 # alias: back
#   grip-mode <name> status
#
# The marker lives at state/session/<name>-mode.json and expires after --ttl
# (default 3600s, max 43200s); an expired marker reads INACTIVE and is reaped.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
GRIP_ROOT="$(dirname "$SCRIPT_DIR")"
source "$GRIP_ROOT/scripts/lib/venv-utils.sh"
# $GRIP_PYTHON still wins; otherwise resolve the venv (any platform layout).
PY="${GRIP_PYTHON:-}"
if [[ ! -x "$PY" ]]; then
    if ! PY="$(resolve_venv_python "$GRIP_ROOT/venv")"; then
        echo "[grip-mode] no Python interpreter found (searched $GRIP_ROOT/venv, then PATH)" >&2
        exit 1
    fi
fi

exec env PYTHONPATH="$GRIP_ROOT" "$PY" "$GRIP_ROOT/lib/session_mode.py" "$@"
