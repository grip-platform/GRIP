<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grip.copilot-gog-absorb</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>-c</string>
        <string>cd __HOME__/.claude &amp;&amp; PYTHONPATH=. __HOME__/.claude/venv/bin/python scripts/copilot-absorb-gog.py --quiet</string>
    </array>

    <key>StartInterval</key>
    <integer>3600</integer>

    <key>RunAtLoad</key>
    <false/>

    <key>WakeFromSleep</key>
    <false/>

    <key>Nice</key>
    <integer>10</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/copilot-gog-absorb.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/copilot-gog-absorb.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key>
        <string>Africa/Johannesburg</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
