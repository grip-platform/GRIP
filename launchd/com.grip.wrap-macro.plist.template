<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grip.wrap-macro</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/venv/bin/python3</string>
        <string>__HOME__/.claude/lib/osa_schedule_trigger.py</string>
        <string>wrap</string>
    </array>

    <!-- 19:00 every day -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>19</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PYTHONPATH</key>
        <string>__HOME__/.claude</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/launchd-wrap.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/launchd-wrap.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
