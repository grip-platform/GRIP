<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grip.branch-prune</string>

    <key>ProgramArguments</key>
    <array>
        <string>__HOME__/.claude/bin/grip-branch-prune</string>
        <string>__HOME__/.grip</string>
    </array>

    <!-- 04:00 every day: prune local branches merged into origin/main. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>4</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/branch-prune.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/branch-prune.log</string>

    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
