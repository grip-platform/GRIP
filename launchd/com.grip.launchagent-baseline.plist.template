<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grip.launchagent-baseline</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>__HOME__/.claude/bin/launchagent-baseline.sh</string>
    </array>

    <!-- Every 6 hours; aligned with daily 06:30 settings monitor -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>6</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>12</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Hour</key><integer>18</integer><key>Minute</key><integer>15</integer></dict>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>HOME</key>
        <string>__HOME__</string>
        <key>CLAUDE_DIR</key>
        <string>__HOME__/.claude</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
        <key>TZ</key>
        <string>Africa/Johannesburg</string>
    </dict>

    <key>WorkingDirectory</key>
    <string>__HOME__/.claude</string>

    <key>WakeFromSleep</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/security/launchagent-baseline.log</string>
    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/security/launchagent-baseline.log</string>

    <key>RunAtLoad</key>
    <false/>

    <key>Nice</key>
    <integer>10</integer>

    <key>TimeOut</key>
    <integer>30</integer>
</dict>
</plist>
