<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.grip.copilot-morning-brief</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/env</string>
        <string>bash</string>
        <string>-c</string>
        <string>cd __HOME__/.claude &amp;&amp; PYTHONPATH=. __HOME__/.claude/venv/bin/python -m lib.copilot.brief morning --post</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>7</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>WakeFromSleep</key>
    <true/>

    <key>Nice</key>
    <integer>5</integer>

    <key>StandardOutPath</key>
    <string>__HOME__/.claude/logs/copilot-morning-brief.log</string>

    <key>StandardErrorPath</key>
    <string>__HOME__/.claude/logs/copilot-morning-brief.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>TZ</key>
        <string>Africa/Johannesburg</string>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin</string>
    </dict>
</dict>
</plist>
